{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "gender": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "timestamp" }
      }
    },
    "UsernameMapping": {
